{
  "name": "medan",
  "version": "0.1.0",
  "description": "Review due Anki cards in the band above the Claude Code prompt while Claude works; answers go straight to Anki through AnkiConnect.",
  "author": { "name": "Aleksandr Likhachev", "url": "https://github.com/avlihachev" },
  "homepage": "https://github.com/avlihachev/medan",
  "repository": "https://github.com/avlihachev/medan",
  "license": "MIT",
  "keywords": ["anki", "flashcards", "language-learning", "mod"],
  "types": "./types/index.d.ts",
  "userConfig": {
    "deck": {
      "type": "string",
      "title": "Anki deck",
      "description": "Deck to review, subdecks included.",
      "required": false,
      "default": "Default"
    },
    "ankiConnectUrl": {
      "type": "string",
      "title": "AnkiConnect URL",
      "description": "Where the AnkiConnect add-on listens.",
      "required": false,
      "default": "http://localhost:8765"
    }
  }
}
